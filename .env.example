# Contact form (Resend). Without these the form shows "Email isn't configured".
RESEND_API_KEY=
RESEND_EMAIL=          # verified sender, e.g. "Portfolio <hello@maarcus.dev>"
MY_EMAIL=              # inbox that receives messages

# Optional
NEXT_PUBLIC_BASE_PATH= # optional sub-path, e.g. /portfolio
MAINTENANCE=           # 1 = serve the 503 holding page

# Spam check (Cloudflare Turnstile). Set both to turn it on; the CSP opens up for Cloudflare only when the site key is set.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Confirmation email to the sender. Turn on only together with Turnstile.
CONTACT_AUTOREPLY=

# Booking link shown on /contact and in the palette (Cal.com etc.)
NEXT_PUBLIC_CAL_URL=

# --- Admin / CMS (needs a Postgres database) ---
# Local: a database inside your Postgres container, e.g. postgres://portfolio:<password>@127.0.0.1:5432/portfolio
# Production: the Neon pooled connection string. Run `pnpm db:migrate` after changing it.
DATABASE_URL=
# 32+ random characters. Encrypts the authenticator secret and keys the visitor/IP hashes. Never reuse or commit it.
ADMIN_SECRET=
# One-time token for /admin/setup. After setup finishes, the page is gone for good; you can remove it.
SETUP_TOKEN=
# Public origin of the site, and the WebAuthn relying party. RP ID is the bare domain (localhost in dev).
APP_URL=http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
# Optional: Gemini key for the "translate to German" button in the CMS.
GEMINI_API_KEY=
# Optional: GitHub contribution graph on the home page. Fine-grained token, no scopes needed (public data).
# Without these the graph section is hidden.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Files on Cloudflare R2, served from the assets domain. All six must be set, or the site falls back to
# /public files and Vercel Blob below. Public bucket: custom domain = NEXT_PUBLIC_ASSETS_URL, holds projects/,
# certifications/, logos/, resume.pdf and published media/. Private bucket: every CMS upload, admin-only until published.
# R2 → Manage API tokens → Object Read & Write on both buckets. Then run `pnpm assets:upload` once, BEFORE restarting
# or deploying with these set: until it has run, image URLs would point at files that aren't on the assets domain yet.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
NEXT_PUBLIC_ASSETS_URL=

# Optional, older: CMS media library uploads (Vercel Blob). Create a Blob store in the Vercel project (Storage tab)
# and connect it; that sets this. For local dev, `vercel env pull .env.local` or paste it here.
BLOB_READ_WRITE_TOKEN=

# Daily data-retention job (vercel.json crons → /api/cron/retention). Any long random string; Vercel sends it automatically.
CRON_SECRET=
