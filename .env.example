# Contact form (Resend). Without these the form shows "Email isn't configured".
RESEND_API_KEY=
RESEND_EMAIL=          # verified sender, e.g. "Portfolio <hello@maarcus.dev>"
MY_EMAIL=              # inbox that receives messages

# Optional
NEXT_PUBLIC_BASE_PATH= # optional sub-path, e.g. /portfolio
MAINTENANCE=           # 1 = serve the 503 holding page

# Spam check (Cloudflare Turnstile). Set both to turn it on; the CSP opens up for Cloudflare only when the site key is set.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Confirmation email to the sender. Turn on only together with Turnstile.
CONTACT_AUTOREPLY=

# Booking link shown on /contact and in the palette (Cal.com etc.)
NEXT_PUBLIC_CAL_URL=

# --- Admin / CMS (needs a Postgres database) ---
# Local: a database inside your Postgres container, e.g. postgres://portfolio:<password>@127.0.0.1:5432/portfolio
# Production: the Neon pooled connection string. Run `pnpm db:migrate` after changing it.
DATABASE_URL=
# 32+ random characters. Encrypts the authenticator secret and keys the visitor/IP hashes. Never reuse or commit it.
ADMIN_SECRET=
# One-time token for /admin/setup. After setup finishes, the page is gone for good; you can remove it.
SETUP_TOKEN=
# Public origin of the site, and the WebAuthn relying party. RP ID is the bare domain (localhost in dev).
APP_URL=http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
# Optional: Gemini key for the "translate to German" button in the CMS.
GEMINI_API_KEY=
