# Contact form (Resend). Without these the form shows "Email isn't configured".
RESEND_API_KEY=
RESEND_EMAIL=          # verified sender, e.g. "Portfolio <hello@maarcus.dev>"
MY_EMAIL=              # inbox that receives messages

# Optional
NEXT_PUBLIC_BASE_PATH= # optional sub-path, e.g. /portfolio
MAINTENANCE=           # 1 = serve the 503 holding page

# Spam check (Cloudflare Turnstile). Set both to turn it on; the CSP opens up for Cloudflare only when the site key is set.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Confirmation email to the sender. Turn on only together with Turnstile.
CONTACT_AUTOREPLY=

# Booking link shown on /contact and in the palette (Cal.com etc.)
NEXT_PUBLIC_CAL_URL=
